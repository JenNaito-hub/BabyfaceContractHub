# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://nmgqpirrvzzysgxybccd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ dùng ở server route nếu cần (KHÔNG prefix NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Video Studio (/video) — chỉ cần cho tính năng "Kịch bản AI".
# Không có key thì app vẫn chạy, chỉ sinh kịch bản bằng template offline.
# KHÔNG prefix NEXT_PUBLIC_ — key chỉ được dùng ở server route.
# ANTHROPIC_API_KEY=sk-ant-...

# Video Studio — sinh ảnh/video bằng AI qua fal.ai (tuỳ chọn).
# Thiếu key thì nút "Sinh media bằng AI" báo rõ là chưa cấu hình, phần còn lại vẫn chạy.
# FAL_KEY=...

# Đổi model mà không cần sửa code. Bỏ trống là dùng mặc định bên dưới.
# Danh sách model xem tại https://fal.ai/models
# FAL_IMAGE_MODEL=fal-ai/flux/dev
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video
# FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video
