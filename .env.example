# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://nmgqpirrvzzysgxybccd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ dùng ở server route (KHÔNG prefix NEXT_PUBLIC_).
# Bắt buộc nếu bật webhook nhận đơn từ website: /api/orders/webhook
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chuỗi bí mật website phải gửi kèm header `x-webhook-secret` khi đẩy đơn sang.
# Tự đặt, càng dài càng tốt. Không có biến này thì endpoint trả 501 (tắt).
# ORDER_WEBHOOK_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-that-dai
